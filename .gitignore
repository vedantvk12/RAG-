# ==============================================================================
# Enterprise RAG & Decision Intelligence Platform - Git Ignore Rules
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (CRITICAL: Never commit secrets)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.cert

# ------------------------------------------------------------------------------
# Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
env/
backend/.venv/
backend/venv/
backend/__pycache__/
backend/*/__pycache__/
backend/*/*/__pycache__/
backend/*/*/*/__pycache__/

# Explicitly ensure frontend lib directory is tracked
!frontend/src/lib/**

# Testing & Coverage
.pytest_cache/
backend/.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
pytest_error*.txt
backend/pytest_error*.txt
test.txt
backend/test.txt

# ------------------------------------------------------------------------------
# Node.js & Frontend (Next.js)
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vercel
*.tsbuildinfo

# ------------------------------------------------------------------------------
# Data, Uploads & Persistent Storage
# ------------------------------------------------------------------------------
backend/uploads/*
!backend/uploads/.gitkeep
uploads/*
!uploads/.gitkeep
*.db
*.sqlite
*.sqlite3
postgres_data/
qdrant_data/

# ------------------------------------------------------------------------------
# OS & Editor Artifacts
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
