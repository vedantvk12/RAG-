# ==============================================================================
# Enterprise RAG & Decision Intelligence Platform - Environment Configuration
# ==============================================================================

# Application Settings
PROJECT_NAME="Agentic Enterprise Knowledge Platform"
ENVIRONMENT=development
API_V1_STR=/api/v1

# Security & Authentication
SECRET_KEY=supersecretkey_please_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rag_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=your_qdrant_api_key_if_cloud

# Ingestion & Chunking
UPLOAD_DIR=./uploads
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Embedding Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Hybrid Retrieval & Reranker Configuration
DENSE_TOP_K=20
BM25_TOP_K=20
FINAL_TOP_K=10
RRF_K=60
RERANK_BATCH_SIZE=16
RERANK_TOP_K=5

# LLM Provider Configuration (OpenAI-compatible or OpenRouter)
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
MAX_CONTEXT_TOKENS=4000

# Local AI (Ollama) Fallback
OLLAMA_BASE_URL=http://localhost:11434
